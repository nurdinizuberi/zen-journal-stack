# Backend Environment Variables Template
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=your_secret_key_here_change_in_production

# CORS & URLs
CORS_ORIGIN=http://localhost:3002
FRONTEND_URL=http://localhost:3002
PUBLIC_BASE_URL=http://localhost:5000

# Database (PostgreSQL - required on Render free tier since SQLite files
# are not persisted. Use Neon or Supabase free tier for a persistent DB.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Optional: AI Features (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Web Push notifications (PWA reminders). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@your-app.com

# Production Example (Render):
# PORT=10000
# NODE_ENV=production
# JWT_SECRET=generate_a_secure_random_string_32_chars_minimum
# CORS_ORIGIN=https://your-app.vercel.app
# PUBLIC_BASE_URL=https://your-service.onrender.com
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
# GEMINI_API_KEY=your_actual_api_key
