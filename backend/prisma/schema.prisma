// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  name      String
  entries       JournalEntry[]
  todos         Todo[]
  goals         Goal[]
  habit         Habit[]
  readingBooks  ReadingBook[]
  intentions    DailyIntention[]
  createdAt     DateTime       @default(now())
}

model JournalEntry {
  id          String   @id @default(uuid())
  title       String
  content     String
  mood        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional enrichment
  tags        Json?    @default("[]")   // ["#career", "#learning"]
  lifeArea    String?                   // "Career", "Learning", ...
  isFavorite  Boolean  @default(false)

  // Existing voice/attachment support
  voiceTranscript String?  @default("")
  attachments     Json?
}

model Todo {
  id          String   @id @default(uuid())
  task        String
  isCompleted Boolean  @default(false)
  timeSpent   Int      @default(0) // in minutes
  dueDate     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional enrichment
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  priority    String   @default("medium") // high | medium | low
  lifeArea    String?
  notes       String   @default("")

  @@index([userId])
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  whyItMatters String  @default("")
  lifeArea    String?
  timeframe   String   @default("monthly") // "daily", "weekly", "monthly", "yearly"
  targetDate  DateTime?
  progress    Int      @default(0)       // 0-100
  milestones  Json?    @default("[]")   // [{id,title,completed}]
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  todos       Todo[]
  books       ReadingBook[]

  @@index([userId])
}

model ReadingBook {
  id          String   @id @default(uuid())
  title       String
  author      String
  totalPages  Int
  currentPage Int      @default(0)
  notes       String   @default("")
  completed   Boolean  @default(false)
  status      String   @default("reading") // reading | completed | paused | wishlist
  startDate   DateTime?
  completedDate DateTime?
  keyIdeas    String   @default("")
  reflection  String   @default("")
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  lifeArea    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyIntention {
  id           String   @id @default(uuid())
  date         DateTime
  intention    String
  priority     String?
  desiredState String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Habit {
  id           String     @id @default(uuid())
  name         String
  description  String?
  streakCount  Int        @default(0)
  createdAt    DateTime   @default(now())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(uuid())
  completedAt DateTime // Standardized to YYYY-MM-DD at midnight for precise grid alignment
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedAt]) // Prevents double logging completion for the same habit on the same day
}